{
  "name": "lumia-chat",
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "preview": "vite preview",
    "deploy:cf": "npm run build && wrangler deploy",
    "dev:cf": "wrangler dev"
  },
  "dependencies": {
    "@blocknote/core": "^0.53.0",
    "@blocknote/mantine": "^0.53.0",
    "@blocknote/react": "^0.53.0",
    "@earendil-works/pi-agent-core": "1.5.2",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.0.1",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
